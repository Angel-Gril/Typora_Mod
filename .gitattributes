# 统一换行：仓库内统一 LF，检出时按平台
* text=auto eol=lf

# 源码
*.cs        text diff=csharp
*.rs        text diff=rust
*.js        text
*.ps1       text eol=crlf
*.iss       text
*.md        text
*.json      text
*.yml       text

# 二进制
*.exe       binary
*.dll       binary
*.ico       binary
*.png       binary
*.zip       binary
*.orig      binary

# 语言统计时排除
docs/reports/**  linguist-documentation
dist/**          linguist-generated
build/**/target/** linguist-vendored
